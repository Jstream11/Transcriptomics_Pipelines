
import pandas as pd
import gzip
from pathlib import Path
import pandas as pd

RESULTS_DIR = config.get('results_dir', 'results')
SAMPLESHEET_PATH= config['sample_sheet']
PAIRED_END = config.get('paired_end', True)
CUSTOM_ADAPTERS = config.get('custom_adapters', None)
REF_GENOME_FA = config.get('reference_genome_fa', "ftp://ftp.ensembl.org/pub/release-104/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz")
REF_GENES_GTF = config.get('reference_genes_gtf', "ftp://ftp.ensembl.org/pub/release-104/gtf/homo_sapiens/Homo_sapiens.GRCh38.104.gtf.gz")
ALIGNER = config.get('aligner', 'star')

required_columns = ['sample', 'fastq_1', 'fastq_2', 'strandedness']
allowed_strandedness = ['auto', 'unstranded', 'forward', 'reverse']

def read_fastq(path):
    if path.endswith('.gz'):
        with gzip.open(path, 'rt') as fastq:
            header = fastq.readline().strip()
            print(f"Reading gzipped FASTQ file: {path}")
    else:
        with open(path, 'r') as fastq:
            header = fastq.readline().strip()
            print(f"Reading FASTQ file: {path}")
    if not header.startswith('@'):
        raise ValueError(f"Error: The file {path} does not appear to be a valid FASTQ file.")
    read_id = header[1:].split()[0]
    return read_id.removesuffix("/1").removesuffix("/2")

try:
    Path(SAMPLESHEET_PATH).exists
except FileNotFoundError:
    raise ValueError("Error: The file does not exist.")

SAMPLESHEET = pd.read_csv(SAMPLESHEET_PATH)
found_columns = SAMPLESHEET.columns.tolist()
if found_columns != required_columns:
    raise ValueError(f"Error: The SAMPLESHEET is missing required columns. Found columns: {found_columns}. Required columns: {required_columns}.")
if not SAMPLESHEET['strandedness'].isin(allowed_strandedness).all():
    raise ValueError(f"Error: The SAMPLESHEET contains invalid values for 'strandedness'. Allowed values: {allowed_strandedness}.")

for _, row in SAMPLESHEET.iterrows():
    read1 = row["fastq_1"]
    read2 = row["fastq_2"]
    sample = row["sample"]

    if not Path(read1).is_file():
        raise FileNotFoundError(f"FASTQ not found: {read1}")

    if pd.notna(read2) and read2:
        if not Path(read2).is_file():
            raise FileNotFoundError(f"FASTQ not found: {read2}")

        if read_fastq(read1) != read_fastq(read2):
            raise ValueError(f"First read IDs do not match for sample {sample}")

print("Samplesheet validation completed successfully.")
SAMPLES = SAMPLESHEET['sample'].astype(str).tolist() 


TARGETS = [
    f'{RESULTS_DIR}/multiqc/raw/multiqc_report.html',
    f'{RESULTS_DIR}/multiqc/trimmed/multiqc_report_trimmed.html',
    f'{RESULTS_DIR}/multiqc/all/multiqc_report_all.html'
]


rule all:
    input:
        TARGETS


if not PAIRED_END:
    rule run_fastqc:
        """
        run fastqc on the FASTQ files specified in the samplesheet.
        """
        input:
            fastq_1 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_1'].values[0]
        output:
            fastqc_1 = f'{RESULTS_DIR}/fastqc/raw/{{sample}}_1_fastqc.html'
        params:
            output_dir = f'{RESULTS_DIR}/fastqc/raw'
        conda:
            '../../envs/fastqc.yaml'
        shell:
            """
            fastqc --outdir {params.output_dir} {input.fastq_1}
            """
   
    rule run_multiqc:
        """
        run multiqc to aggregate the fastqc results.
        """
        input:
            expand(f'{RESULTS_DIR}/fastqc/raw/{{sample}}_1_fastqc.html', sample=SAMPLES)
        output:
            f'{RESULTS_DIR}/multiqc/raw/multiqc_report.html'
        params:
            input_dir = f'{RESULTS_DIR}/fastqc/raw',
            outdir = f'{RESULTS_DIR}/multiqc/raw/',
            filename = 'multiqc_report.html',
        conda:
            '../../envs/multiqc.yaml'
        shell:
            """
            multiqc --force --outdir {params.outdir} --filename {params.filename} {params.input_dir}
            """
### ADAPTER TRIMMING ###
    if not CUSTOM_ADAPTERS:
        trimmer = 'fastp'
        rule run_fastp_trimming:
            """
            run adapter trimming on the FASTQ files specified in the samplesheet.
            """
            input:
                fastq_1 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_1'].values[0]
            output:
                trimmed_fastq_1 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}_trimmed.fastq.gz',
                trimmed_report_html = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_{trimmer}_report.html'   
            conda:
                '../../envs/fastp.yaml'
            shell:
                """
                fastp -i {input.fastq_1} -o {output.trimmed_fastq_1} -h {output.trimmed_report_html}
                """
    else:
        trimmer = 'cutadapt'
        rule run_cutadapt_trimming:
            """
            run adapter trimming on the FASTQ files specified in the samplesheet.
            """
            input:
                fastq_1 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_1'].values[0]
            output:
                trimmed_fastq_1 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}_trimmed.fastq.gz',
                cutadapt_log = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}.log'
            conda:
                '../../envs/cutadapt.yaml'
            params:
                adapter = CUSTOM_ADAPTERS
            shell:
                """
                cutadapt -a {params.adapter} -o {output.trimmed_fastq_1} {input.fastq_1} > {output.cutadapt_log} 2>&1
                """
else:
    rule run_fastqc:
        """
        run fastqc on the FASTQ files specified in the samplesheet.
        """
        input:
            fastq_1 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_1'].values[0],
            fastq_2 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_2'].values[0]
        output:
            fastqc_1 = f'{RESULTS_DIR}/fastqc/raw/{{sample}}_1_fastqc.html',
            fastqc_2 = f'{RESULTS_DIR}/fastqc/raw/{{sample}}_2_fastqc.html'
        params:
            output_dir = f'{RESULTS_DIR}/fastqc/raw'
        conda:
            '../../envs/fastqc.yaml'
        shell:
            """
            fastqc --outdir {params.output_dir} {input.fastq_1} {input.fastq_2}
            """
 
    rule run_multiqc:
        """
        run multiqc to aggregate the fastqc results.
        """
        input:
            expand(f'{RESULTS_DIR}/fastqc/raw/{{sample}}_1_fastqc.html', sample=SAMPLES),
            expand(f'{RESULTS_DIR}/fastqc/raw/{{sample}}_2_fastqc.html', sample=SAMPLES)
        output:
            f'{RESULTS_DIR}/multiqc/raw/multiqc_report.html'
        params:
            input_dir = f'{RESULTS_DIR}/fastqc/raw',
            outdir = f'{RESULTS_DIR}/multiqc/raw/',
            filename = 'multiqc_report.html',
        conda:
            '../../envs/multiqc.yaml'
        shell:
            """
            multiqc --force --outdir {params.outdir} --filename {params.filename} {params.input_dir}
            """
### ADAPTER TRIMMING ###
    if not CUSTOM_ADAPTERS:
        trimmer = 'fastp'
        rule run_fastp_trimming:
            """
            run adapter trimming on the FASTQ files specified in the samplesheet.
            """
            input:
                fastq_1 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_1'].values[0],
                fastq_2 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_2'].values[0]
            output:
                trimmed_fastq_1 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}_trimmed.fastq.gz',
                trimmed_fastq_2 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_2_{trimmer}_trimmed.fastq.gz',
                trimmed_report_html = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_{trimmer}_report.html'
            conda:
                '../../envs/fastp.yaml'
            shell:
                """
                fastp -i {input.fastq_1} -I {input.fastq_2} -o {output.trimmed_fastq_1} -O {output.trimmed_fastq_2} -h {output.trimmed_report_html}   
                """
    else:
        trimmer = 'cutadapt'

        rule run_cutadapt_trimming:
            """
            run adapter trimming on the FASTQ files specified in the samplesheet.
            """
            input:
                fastq_1 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_1'].values[0],
                fastq_2 = lambda wildcards: SAMPLESHEET.loc[SAMPLESHEET['sample'] == wildcards.sample, 'fastq_2'].values[0]
            output:
                trimmed_fastq_1 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}_trimmed.fastq.gz',
                trimmed_fastq_2 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_2_{trimmer}_trimmed.fastq.gz',
                cutadapt_log = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}.log'
            conda:
                '../../envs/cutadapt.yaml'
            params:
                adapter = CUSTOM_ADAPTERS
            shell:
                """
                cutadapt -a {params.adapter} -o {output.trimmed_fastq_1} -p {output.trimmed_fastq_2} {input.fastq_1} {input.fastq_2} > {output.cutadapt_log} 2>&1
                """

rule run_fastqc_trimmed:
    """
    run fastqc on the trimmed FASTQ files specified in the samplesheet.
    """
    input:
        trimmed_fastq_1 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}_trimmed.fastq.gz',
        trimmed_fastq_2 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_2_{trimmer}_trimmed.fastq.gz'
    output:
        fastqc_1 = f'{RESULTS_DIR}/fastqc/trimmed/{{sample}}_1_{trimmer}_trimmed_fastqc.html',
        fastqc_2 = f'{RESULTS_DIR}/fastqc/trimmed/{{sample}}_2_{trimmer}_trimmed_fastqc.html'
    params:
        output_dir = f'{RESULTS_DIR}/fastqc/trimmed'
    conda:
        '../../envs/fastqc.yaml'
    shell:
        """
        fastqc --outdir {params.output_dir} {input.trimmed_fastq_1} {input.trimmed_fastq_2}
        """

rule run_multiqc_trimmed:
    """
    run multiqc to aggregate the fastqc and trimmer specific results of the trimmed FASTQ files.
    """
    input:
        expand(f'{RESULTS_DIR}/fastqc/trimmed/{{sample}}_1_{trimmer}_trimmed_fastqc.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastqc/trimmed/{{sample}}_2_{trimmer}_trimmed_fastqc.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}.log', sample=SAMPLES) if CUSTOM_ADAPTERS 
                else [f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_{trimmer}_report.html' for sample in SAMPLES]
    output:
        f'{RESULTS_DIR}/multiqc/trimmed/multiqc_report_trimmed.html'
    params:
        fastqc_dir = f'{RESULTS_DIR}/fastqc/trimmed',
        trimmer_dir = f'{RESULTS_DIR}/trimmed/{trimmer}',
        outdir = f'{RESULTS_DIR}/multiqc/trimmed/',
        filename = 'multiqc_report_trimmed.html'
    conda:
        '../../envs/multiqc.yaml'
    shell:
        """
        multiqc --force --outdir {params.outdir} --filename {params.filename} {params.fastqc_dir} {params.trimmer_dir}
        """
### ALIGNMENT ###
rule get_reference_genome:
    """
    download the reference genome.
    """
    output:
        f'{RESULTS_DIR}/star/genome_index/genome.fa',
        f'{RESULTS_DIR}/star/genome_index/genes.gtf'
    params:
        genome_dir = f'{RESULTS_DIR}/star/genome_index',
        ref_genome_fa = REF_GENOME_FA,
        ref_genes_gtf = REF_GENES_GTF
    conda:
        '../../envs/star.yaml'
    shell:
        """
        mkdir -p {params.genome_dir}
        wget -O {params.genome_dir}/genome.fa.gz {params.ref_genome_fa}
        gunzip {params.genome_dir}/genome.fa.gz
        wget -O {params.genome_dir}/genes.gtf.gz {params.ref_genes_gtf}
        gunzip {params.genome_dir}/genes.gtf.gz
        """

if ALIGNER == 'star':
    rule create_star_index:
        """
        create STAR genome index from the reference genome and GTF file.
        """
        input:
            genome_fa = f'{RESULTS_DIR}/star/genome_index/genome.fa',
            genes_gtf = f'{RESULTS_DIR}/star/genome_index/genes.gtf'
        output:
            f'{RESULTS_DIR}/star/genome_index/SAindex'
        params:
            genome_dir = f'{RESULTS_DIR}/star/genome_index'
        conda:
            '../../envs/star.yaml'
        shell:
            """ 
            STAR --runThreadN 4 --runMode genomeGenerate --genomeDir {params.genome_dir} --genomeFastaFiles {input.genome_fa} --sjdbGTFfile {input.genes_gtf} --sjdbOverhang 100
            """

    rule run_star:
        """
        run STAR alignment on the trimmed FASTQ files specified in the samplesheet.
        """
        input:
            f'{RESULTS_DIR}/star/genome_index/SAindex',
            trimmed_fastq_1 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}_trimmed.fastq.gz',
            trimmed_fastq_2 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_2_{trimmer}_trimmed.fastq.gz'
        output:
            f"{RESULTS_DIR}/star/{{sample}}/Aligned.sortedByCoord.out.bam",
            f"{RESULTS_DIR}/star/{{sample}}/Log.final.out"
        params:
            genome_dir = f'{RESULTS_DIR}/star/genome_index',
            star_output_dir = f'{RESULTS_DIR}/star/{{sample}}/'
        conda:
            '../../envs/star.yaml'
        shell:
            """
            STAR --runThreadN 4 \
                --genomeDir {params.genome_dir:q} \
                --readFilesIn {input.trimmed_fastq_1:q} {input.trimmed_fastq_2:q} \
                --readFilesCommand zcat \
                --outTmpDir /tmp/STARtmp_{wildcards.sample} \
                --outFileNamePrefix {params.star_output_dir:q} \
                --outSAMtype BAM SortedByCoordinate
            """

if ALIGNER == 'salmon': 
    rule create_salmon_index:
        """
        create Salmon index from the reference genome and GTF file. 
        """
        input:
            genome_fa = f'{RESULTS_DIR}/star/genome_index/genome.fa'
        output:
            salmon_index_dir = directory(f"{RESULTS_DIR}/salmon/salmon_index")  
        conda:
            '../../envs/salmon.yaml' 
        threads: 2
        shell:
            """
            salmon index -t {input.genome_fa} -i {output.salmon_index_dir} -p 2
            """
    rule run_salmon:
        """
        run Salmon quantification on the trimmed FASTQ files specified in the samplesheet.
        """
        input:
            salmon_index = f'{RESULTS_DIR}/salmon/salmon_index',
            trimmed_fastq_1 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_1_{trimmer}_trimmed.fastq.gz',
            trimmed_fastq_2 = f'{RESULTS_DIR}/trimmed/{trimmer}/{{sample}}_2_{trimmer}_trimmed.fastq.gz'
        output:
            f"{RESULTS_DIR}/salmon/{{sample}}/quant.sf"
        params:
            output_dir = f"{RESULTS_DIR}/salmon/{{sample}}"
        conda:
            '../../envs/salmon.yaml'
        shell:
            """
            salmon quant -i {input.salmon_index} -l A -1 {input.trimmed_fastq_1} -2 {input.trimmed_fastq_2} -p 4 --validateMappings -o {params.output_dir}
            """

rule run_multiqc_all:
    """
    run multiqc to aggregate the results of the entire workflow.
    """
    input:
        f'{RESULTS_DIR}/multiqc/raw/multiqc_report.html',
        f'{RESULTS_DIR}/multiqc/trimmed/multiqc_report_trimmed.html',
        expand(f'{RESULTS_DIR}/star/{{sample}}/Log.final.out', sample=SAMPLES) if ALIGNER == 'star' else 
            expand(f'{RESULTS_DIR}/salmon/{{sample}}/quant.sf', sample=SAMPLES)
    output:
        f'{RESULTS_DIR}/multiqc/all/multiqc_report_all.html'
    params:
        multiqc_dirs = f'{RESULTS_DIR}/multiqc/raw {RESULTS_DIR}/multiqc/trimmed',
        aligner_dirs = f'{RESULTS_DIR}/star' if ALIGNER == 'star' else f'{RESULTS_DIR}/salmon',
        outdir = f'{RESULTS_DIR}/multiqc/all/',
        filename = 'multiqc_report_all.html'
    conda:
        '../../envs/multiqc.yaml'
    shell:
        """
        multiqc --force --outdir {params.outdir} --filename {params.filename} {params.multiqc_dirs} {params.aligner_dirs}
        """